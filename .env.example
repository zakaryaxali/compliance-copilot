# Copy to .env (gitignored) and fill in real values.
# Do not commit .env.
#
# Primary inference backend (Together.ai — hosts Mistral 7B Instruct v0.3
# under that exact model name; OpenAI-compatible API).
TOGETHER_API_KEY=replace_with_your_together_key
#
# Optional fallback / future use.
HF_TOKEN=hf_replace_with_your_token
#
# Zscaler workaround for SSL cert verification on the corporate network.
# Rebuild with scripts/build_ca_bundle.sh (TBD) if Zscaler root rotates.
SSL_CERT_FILE=.certs/ca-bundle.pem
REQUESTS_CA_BUNDLE=.certs/ca-bundle.pem
